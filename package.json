{
  "name": "frontend",
  "version": "0.0.0",
  "lint-staged": {
    "src/**/*.{ts,html,scss}": [
      "npm run lint -- --fix",
      "npm run format -- --write"
    ]
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --runInBand --ci",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "serve:ssr:frontend": "node dist/frontend/server/server.mjs",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --check \"src/**/*.{ts,html,scss,json,md}\"",
    "docs": "npx compodoc -p tsconfig.json -d docs/compodoc"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.1.2",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/material": "^20.1.2",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-server": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@angular/ssr": "^20.0.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@compodoc/compodoc": "^1.1.26",
    "@jest/globals": "^30.0.5",
    "@playwright/test": "^1.54.2",
    "@swc/core": "^1.13.3",
    "@swc/jest": "^0.2.39",
    "@testing-library/angular": "^18.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.17.19",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint-config-prettier": "^10.1.8",
    "jasmine-core": "~5.7.0",
    "jest-preset-angular": "^15.0.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "testing-library": "^0.0.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.2",
    "vitest": "^3.2.4"
  }
}